{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "frontend": "vite --port=3000 --host=0.0.0.0",
    "backend": "npm --prefix backend run dev",
    "start": "concurrently \"npm run frontend\" \"npm run backend\"",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "server": "node backend/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "db:init": "node backend/scripts/initDb.js",
    "db:verify": "node backend/scripts/verifyLogin.js",
    "test:e2e": "npx playwright test",
    "test:e2e:auth": "npx playwright test auth.setup.ts",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.7.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^1.28.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^2.12.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
