# Application Secrets & Configuration
# Copy this file to .env and fill in real values.
# On Vercel: add these in Dashboard → Settings → Environment Variables

# ── Required ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (use the POOLER URL for serverless)
DATABASE_URL=postgresql://neondb_owner:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# JWT signing secret — must be the same on every deployment
JWT_SECRET=cams_jwt_secret_key_2024

# Node environment
NODE_ENV=production

# ── Optional (local dev only) ─────────────────────────────────────────────────
PORT=3000
