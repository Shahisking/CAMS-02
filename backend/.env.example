# Backend Configuration Template
# Duplicate this file to .env and fill in the values below

# Port for backend server
PORT=5000

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=college_assets

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/college_assets

# JSON Web Token Secret
JWT_SECRET=

# Gemini API Key (if required for AI features)
GEMINI_API_KEY=
